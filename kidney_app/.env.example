# LLM backend: Nebius is the default; set LLM_PROVIDER=anthropic to opt in to Anthropic.
LLM_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.eu-north1.nebius.com/v1/
MODEL_MAIN=moonshotai/Kimi-K3.1-Pro
MODEL_FAST=Qwen/Qwen3-30B-A3B-Instruct-2507

# Optional Anthropic provider (only used when explicitly selected):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# MODEL_MAIN=claude-sonnet-5-5
# MODEL_FAST=claude-haiku-5-5
# Eval only: grade with a different provider than the one under test
# JUDGE_PROVIDER=nebius
# JUDGE_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname   # default: sqlite file in data/
NCBI_API_KEY=
OPENFDA_API_KEY=
CONTACT_EMAIL=team@example.com
SAFETY_LLM_CHECK=1

# ---- deployment ----
DOMAIN=api.example.com                 # your domain (A record -> VM IP); Caddy gets the HTTPS certificate
APP_SHARED_SECRET=                     # long random string; same value as the Base44 secret KIDNEY_API_SECRET
REMINDER_WEBHOOK_URL=                  # https://<your-base44-app-domain>/functions/reminder-relay
REMINDER_WEBHOOK_SECRET=               # long random string; same value as the Base44 secret RELAY_SECRET
RATE_LIMIT_PER_MIN=12
RATE_LIMIT_PER_DAY=300
# ALLOWED_ORIGINS=                     # leave empty in production (browser only talks to Base44)
